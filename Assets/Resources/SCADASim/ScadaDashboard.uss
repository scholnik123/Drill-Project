.scada-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    color: #111111;
    -unity-font-style: bold;
}

.scada-viewport {
    position: absolute;
    width: 1600px;
    height: 1080px;
    overflow: hidden;
    transform-origin: 0px 0px;
    background-color: rgba(0, 0, 0, 0);
}

.start-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #e9e6de;
}

.intro-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #07080b;
    align-items: center;
    justify-content: center;
}

.intro-logo-block {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.intro-logo-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.intro-logo {
    color: #f2f0e8;
    font-size: 138px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.intro-logo-rule {
    width: 330px;
    height: 5px;
    margin-top: 10px;
    margin-bottom: 18px;
    background-color: #d90818;
}

.intro-caption {
    position: absolute;
    bottom: 58px;
    color: rgba(242, 240, 232, 0.82);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.intro-skip-button {
    position: absolute;
    right: 24px;
    bottom: 18px;
    width: 132px;
    height: 34px;
    background-color: rgba(233, 230, 222, 0.08);
    color: #f2f0e8;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(242, 240, 232, 0.52);
    font-size: 11px;
    -unity-font-style: bold;
}

.intro-skip-button:hover {
    background-color: #d90818;
    border-color: #d90818;
}

.window-titlebar {
    height: 26px;
    background-color: #1d1d1d;
    color: #e9e6de;
    font-size: 11px;
    padding-left: 8px;
    justify-content: center;
}

.start-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    bottom: 0;
}

.brand-zone {
    position: absolute;
    left: 92px;
    top: 120px;
    width: 480px;
    height: 440px;
    align-items: center;
    justify-content: center;
}

.lukoil-logo {
    font-size: 54px;
    color: #d90818;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.brand-cross {
    margin-top: 18px;
    font-size: 26px;
    color: #4c5052;
    -unity-text-align: middle-center;
}

.zvz-logo {
    margin-top: 20px;
    font-size: 60px;
    color: #101010;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.start-subtitle {
    margin-top: 26px;
    font-size: 13px;
    color: #111111;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.scenario-box {
    width: 430px;
    margin-top: 20px;
    padding: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #111111;
    font-size: 11px;
    white-space: normal;
}

.start-config-panel {
    position: absolute;
    right: 120px;
    top: 50px;
    width: 520px;
    height: 970px;
    padding: 18px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
}

.start-config-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.zvz-brand-image {
    margin-top: 18px;
    width: 430px;
    height: 190px;
    -unity-background-scale-mode: scale-to-fit;
}

.config-row {
    height: 30px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.config-label {
    width: 180px;
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
    color: #111111;
}

.config-choice {
    height: 27px;
    flex-grow: 1;
    background-color: #e9e6de;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #111111;
    color: #111111;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 12px;
}

.config-choice:hover {
    background-color: #f3f0e8;
}

.start-button {
    height: 42px;
    margin-top: 12px;
    background-color: #111111;
    color: #f2f0e8;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.start-button:hover {
    background-color: #d90818;
}

.main-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.main-tabs {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 50px;
    background-color: #e9e6de;
    border-bottom-width: 2px;
    border-bottom-color: #111111;
    flex-direction: row;
    align-items: center;
}

.tab-button {
    width: 190px;
    height: 48px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 2px;
    border-right-color: #111111;
    font-size: 13px;
    -unity-font-style: bold;
}

.tab-active {
    background-color: #111111;
    color: #f2f0e8;
}

.profile-view-buttons {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    padding-left: 8px;
}

.flat-button {
    height: 32px;
    min-width: 82px;
    margin-right: 6px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    font-size: 11px;
    -unity-font-style: bold;
}

.flat-button:hover {
    background-color: #111111;
    color: #f2f0e8;
}

.telemetry-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
    background-color: #e9e6de;
    flex-direction: row;
    padding: 8px;
}

.continue-button {
    margin-top: 6px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
}

.save-slot-title {
    margin-top: 10px;
    margin-bottom: 5px;
    font-size: 12px;
    color: #111111;
    -unity-font-style: bold;
}

.save-slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.save-slot-button {
    width: 154px;
    height: 43px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
}

.save-slot-active {
    background-color: #111111;
    color: #f2f0e8;
}

.save-slot-hint {
    min-height: 28px;
    font-size: 10px;
    color: #4f4b45;
    white-space: normal;
}

.load-slot-button {
    height: 34px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    font-size: 11px;
    -unity-font-style: bold;
}

.crew-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
    background-color: #e9e6de;
    flex-direction: row;
    padding: 8px;
}

.telemetry-left {
    width: 450px;
    height: 100%;
}

.telemetry-center {
    width: 340px;
    height: 100%;
    margin-left: 10px;
    margin-right: 10px;
}

.telemetry-right {
    flex-grow: 1;
    height: 100%;
    min-width: 650px;
    overflow: hidden;
}

.telemetry-right-content {
    padding-right: 8px;
    padding-bottom: 12px;
    flex-direction: column;
}

.telemetry-right .scada-panel {
    margin-bottom: 8px;
}

.scada-panel {
    background-color: #e9e6de;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 7px;
    margin-bottom: 8px;
}

.scada-panel-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.graph-panel {
    height: 260px;
}

.graph-help-label {
    min-height: 34px;
    margin-bottom: 5px;
    color: #4f4b45;
    font-size: 9px;
    white-space: normal;
}

.graph-container {
    position: relative;
    flex-grow: 1;
    overflow: visible;
}

.trend-graph-light {
    flex-grow: 1;
    background-color: #e9e6de;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(17, 17, 17, 0.18);
    overflow: visible;
}

.graph-label {
    position: absolute;
    font-size: 10px;
    -unity-font-style: bold;
    padding: 1px 2px;
    background-color: rgba(233, 230, 222, 0.82);
    border-width: 0;
    color: #000000;
}

.graph-label-primary-max { left: 8px; top: 30px; }
.graph-label-primary-min { left: 8px; bottom: 22px; }
.graph-label-secondary-max { right: 8px; top: 30px; }
.graph-label-secondary-min { right: 8px; bottom: 22px; }
.graph-label-primary-current { left: 52px; bottom: 22px; width: 86px; }
.graph-label-secondary-current { right: 52px; bottom: 22px; width: 86px; -unity-text-align: middle-right; }
.graph-label-status { left: 36%; top: 23px; width: 126px; -unity-text-align: middle-center; color: #111111; }

.graph-label-x-start { left: 8px; bottom: 8px; border-width: 0; background-color: transparent; }
.graph-label-x-end { right: 8px; bottom: 8px; border-width: 0; background-color: transparent; }

.graph-axis-title {
    position: absolute;
    font-size: 11px;
    -unity-font-style: bold;
    color: #000000;
    background-color: rgba(233, 230, 222, 0.92);
    border-width: 0;
    padding: 1px 3px;
    -unity-text-align: middle-center;
}

.graph-axis-title-left { left: 46px; top: 5px; width: 142px; }
.graph-axis-title-right { right: 46px; top: 5px; width: 150px; }
.graph-axis-title-bottom { left: 41%; bottom: 4px; width: 106px; }

.env-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.config-line {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: #111111;
    white-space: normal;
}

.mini-brand {
    width: 90px;
    flex-shrink: 0;
    font-size: 13px;
    color: #d90818;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.status-box {
    min-height: 28px;
    margin-top: 6px;
    padding: 5px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    color: #111111;
    font-size: 10px;
    white-space: normal;
}

.telemetry-panel {
    min-height: 196px;
}

.pressure-panel {
    height: 248px;
}

.pressure-numbers {
    flex-direction: row;
    height: 58px;
    margin-bottom: 4px;
}

.pressure-number {
    flex-grow: 1;
    min-height: 54px;
}

.pressure-label {
    color: #66615b;
    font-size: 10px;
    height: 18px;
}

.pressure-value {
    margin-top: 2px;
    color: #111111;
    font-size: 22px;
    -unity-font-style: bold;
    height: 30px;
}

.pressure-graph {
    height: 108px;
    margin-top: 0;
    background-color: #e9e6de;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(17, 17, 17, 0.18);
    overflow: visible;
}

.crew-action-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.crew-action-grid .flat-button {
    width: 103px;
    min-width: 103px;
    height: 24px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-size: 8px;
}

.crew-page .crew-action-grid .flat-button {
    width: 188px;
    min-width: 188px;
    height: 38px;
    margin-right: 8px;
    margin-bottom: 8px;
    font-size: 10px;
    white-space: normal;
}

.crew-column-main {
    width: 760px;
    height: 100%;
    margin-right: 12px;
}

.crew-column-side {
    flex-grow: 1;
    height: 100%;
    min-width: 430px;
}

.crew-page .status-box {
    min-height: 42px;
    font-size: 11px;
    padding: 7px;
}

.crew-shift-panel {
    min-height: 242px;
}

.crew-radio-panel {
    min-height: 164px;
}

.crew-actions-panel {
    min-height: 312px;
}

.crew-doctrine-panel {
    min-height: 360px;
}

.crew-note {
    font-size: 11px;
    color: #4f4b45;
    margin-bottom: 6px;
    white-space: normal;
}

.crew-image-strip {
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 2px;
}

.generated-widget-image {
    width: 64px;
    height: 40px;
    margin-right: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #111111;
    -unity-background-scale-mode: scale-to-fit;
}

.metric-grid-light {
    flex-direction: row;
    flex-wrap: wrap;
}

.metric-item-light {
    width: 18%;
    min-height: 35px;
    margin-right: 2%;
    margin-bottom: 5px;
}

.metric-title-light {
    color: #66615b;
    font-size: 8px;
}

.metric-value-light {
    margin-top: 1px;
    color: #000000;
    font-size: 15px;
    -unity-font-style: bold;
}

.control-panel {
    min-height: 260px;
}

.crew-page .crew-image-strip .generated-widget-image {
    width: 138px;
    height: 84px;
    margin-right: 10px;
}

.control-row {
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.control-label {
    width: 156px;
    font-size: 11px;
}

.control-button {
    flex-grow: 1;
    margin-right: 5px;
    height: 25px;
    min-width: 88px;
}

.knob-row {
    height: 38px;
    flex-direction: row;
    align-items: center;
}

.knob-label {
    width: 134px;
    font-size: 10px;
    white-space: normal;
}

.knob-control {
    width: 38px;
    height: 38px;
    margin-right: 10px;
    flex-shrink: 0;
}

.knob-hint {
    flex-grow: 1;
    color: #66615b;
    font-size: 9px;
    white-space: normal;
}

.time-speed-row {
    margin-top: 3px;
}

.time-speed-button {
    width: 46px;
    min-width: 44px;
    height: 22px;
    margin-right: 4px;
    font-size: 9px;
}

.music-row {
    margin-top: 2px;
}

.music-status-label {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 6px;
    font-size: 8px;
    white-space: normal;
}

.ai-panel {
    min-height: 350px;
}

.ai-assistant-row {
    flex-direction: row;
    min-height: 48px;
    margin-bottom: 3px;
    align-items: center;
}

.ai-assistant-portrait {
    width: 44px;
    height: 44px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    margin-right: 10px;
}

.ai-assistant-row .generated-widget-image {
    width: 56px;
    height: 36px;
    flex-shrink: 0;
}

.ai-assistant-caption {
    flex-grow: 1;
    font-size: 9px;
    white-space: normal;
}

.ai-panel .status-box {
    min-height: 52px;
    margin-top: 5px;
    padding: 6px;
    font-size: 10px;
}

.ai-panel .ai-crew-advisor-box {
    min-height: 58px;
    font-size: 10px;
}

.ai-panel .supervisor-task-box {
    min-height: 96px;
    font-size: 10px;
}

.ai-footer-row {
    flex-direction: row;
    margin-top: 3px;
}

.ai-footer-row .status-box {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 42px;
    margin-top: 0;
    margin-right: 4px;
    font-size: 9px;
}

.profile-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.profile-status {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 430px;
    min-height: 86px;
    background-color: rgba(233, 230, 222, 0.92);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 12px;
}

.profile-data-panel {
    position: absolute;
    right: 18px;
    top: 18px;
    width: 430px;
    min-height: 250px;
    background-color: rgba(233, 230, 222, 0.94);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 12px;
}

.profile-data-panel .status-box {
    min-height: 42px;
    font-size: 10px;
}

.profile-status-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.profile-status-body {
    margin-top: 8px;
    font-size: 11px;
    white-space: normal;
}

.tutorial-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
    background-color: rgba(17, 17, 17, 0.28);
    align-items: center;
    justify-content: center;
}

.tutorial-panel {
    width: 820px;
    min-height: 390px;
    background-color: #e9e6de;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 24px;
}

.tutorial-title {
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.tutorial-body {
    min-height: 210px;
    font-size: 14px;
    white-space: normal;
}

.tutorial-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

.tutorial-buttons .flat-button {
    width: 150px;
}
