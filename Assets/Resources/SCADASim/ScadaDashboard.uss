.scada-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: #111111;
    -unity-font-style: bold;
}

.start-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #e9e6de;
}

.intro-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #050505;
}

.intro-video {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.intro-caption {
    position: absolute;
    left: 24px;
    bottom: 22px;
    color: rgba(242, 240, 232, 0.86);
    font-size: 12px;
}

.intro-skip-button {
    position: absolute;
    right: 24px;
    bottom: 18px;
    width: 132px;
    height: 34px;
    background-color: rgba(233, 230, 222, 0.08);
    color: #f2f0e8;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(242, 240, 232, 0.52);
    font-size: 11px;
    -unity-font-style: bold;
}

.intro-skip-button:hover {
    background-color: #d90818;
    border-color: #d90818;
}

.window-titlebar {
    height: 26px;
    background-color: #1d1d1d;
    color: #e9e6de;
    font-size: 11px;
    padding-left: 8px;
    justify-content: center;
}

.start-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    bottom: 0;
}

.brand-zone {
    position: absolute;
    left: 70px;
    top: 86px;
    width: 500px;
    height: 540px;
    align-items: center;
    justify-content: center;
}

.lukoil-logo {
    font-size: 62px;
    color: #d90818;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.brand-cross {
    margin-top: 24px;
    font-size: 30px;
    color: #4c5052;
    -unity-text-align: middle-center;
}

.zvz-logo {
    margin-top: 26px;
    font-size: 72px;
    color: #101010;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.start-subtitle {
    margin-top: 36px;
    font-size: 14px;
    color: #111111;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.scenario-box {
    width: 470px;
    margin-top: 22px;
    padding: 12px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    font-size: 11px;
    white-space: normal;
}

.start-config-panel {
    position: absolute;
    right: 80px;
    top: 52px;
    width: 470px;
    height: 720px;
    padding: 26px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
}

.start-config-title {
    font-size: 23px;
    -unity-font-style: bold;
    margin-bottom: 22px;
}

.config-label {
    font-size: 11px;
    margin-top: 8px;
    margin-bottom: 6px;
    color: #111111;
}

.config-choice {
    height: 32px;
    background-color: #e9e6de;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    color: #111111;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 12px;
}

.config-choice:hover {
    background-color: #f3f0e8;
}

.start-button {
    height: 54px;
    margin-top: 20px;
    background-color: #111111;
    color: #f2f0e8;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.start-button:hover {
    background-color: #d90818;
}

.main-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.main-tabs {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 50px;
    background-color: #e9e6de;
    border-bottom-width: 2px;
    border-bottom-color: #111111;
    flex-direction: row;
    align-items: center;
}

.tab-button {
    width: 190px;
    height: 48px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 2px;
    border-right-color: #111111;
    font-size: 13px;
    -unity-font-style: bold;
}

.tab-active {
    background-color: #111111;
    color: #f2f0e8;
}

.profile-view-buttons {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    padding-left: 8px;
}

.flat-button {
    height: 32px;
    min-width: 82px;
    margin-right: 6px;
    background-color: #e9e6de;
    color: #111111;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    font-size: 11px;
    -unity-font-style: bold;
}

.flat-button:hover {
    background-color: #111111;
    color: #f2f0e8;
}

.telemetry-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
    background-color: #e9e6de;
    flex-direction: row;
    padding: 12px;
}

.telemetry-left {
    width: 390px;
    height: 100%;
}

.telemetry-center {
    width: 360px;
    height: 100%;
    margin-left: 12px;
    margin-right: 12px;
}

.telemetry-right {
    flex-grow: 1;
    height: 100%;
    min-width: 650px;
}

.scada-panel {
    background-color: #e9e6de;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 9px;
    margin-bottom: 10px;
}

.scada-panel-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.graph-panel {
    height: 190px;
}

.trend-graph-light {
    flex-grow: 1;
    background-color: #e9e6de;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(17, 17, 17, 0.18);
}

.graph-label {
    position: absolute;
    font-size: 12px;
    -unity-font-style: bold;
    padding: 2px 4px;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #000000;
    color: #000000;
    picking-mode: ignore;
}

.graph-label-primary-max { left: 8px; top: 8px; }
.graph-label-primary-min { left: 8px; bottom: 30px; }
.graph-label-secondary-max { right: 8px; top: 8px; }
.graph-label-secondary-min { right: 8px; bottom: 30px; }

.graph-label-x-start { left: 8px; bottom: 8px; border-width: 0; background-color: transparent; }
.graph-label-x-end { right: 8px; bottom: 8px; border-width: 0; background-color: transparent; }

.graph-axis-title {
    position: absolute;
    font-size: 11px;
    -unity-font-style: bold;
    color: #000000;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #000000;
    padding: 2px;
    picking-mode: ignore;
    -unity-text-align: middle-center;
}

.graph-axis-title-left { left: 5px; top: 40%; width: 100px; rotate: -90deg; }
.graph-axis-title-right { right: 5px; top: 40%; width: 100px; rotate: 90deg; }
.graph-axis-title-bottom { left: 45%; bottom: 6px; width: 60px; }

.env-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.config-line {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: #111111;
    white-space: normal;
}

.mini-brand {
    width: 90px;
    flex-shrink: 0;
    font-size: 13px;
    color: #d90818;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}

.status-box {
    min-height: 28px;
    margin-top: 6px;
    padding: 5px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    color: #111111;
    font-size: 10px;
    white-space: normal;
}

.telemetry-panel {
    height: 270px;
}

.pressure-panel {
    height: 216px;
}

.pressure-numbers {
    flex-direction: row;
    height: 58px;
    margin-bottom: 4px;
}

.pressure-number {
    flex-grow: 1;
    min-height: 54px;
}

.pressure-label {
    color: #66615b;
    font-size: 10px;
    height: 18px;
}

.pressure-value {
    margin-top: 2px;
    color: #111111;
    font-size: 22px;
    -unity-font-style: bold;
    height: 30px;
}

.pressure-graph {
    height: 74px;
    margin-top: 0;
    background-color: #e9e6de;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(17, 17, 17, 0.18);
}

.crew-action-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.crew-action-grid .flat-button {
    width: 103px;
    min-width: 103px;
    height: 24px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-size: 8px;
}

.crew-image-strip {
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 2px;
}

.generated-widget-image {
    width: 64px;
    height: 40px;
    margin-right: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #111111;
    -unity-background-scale-mode: scale-to-fit;
}

.metric-grid-light {
    flex-direction: row;
    flex-wrap: wrap;
}

.metric-item-light {
    width: 18%;
    min-height: 37px;
    margin-right: 2%;
    margin-bottom: 3px;
}

.metric-title-light {
    color: #66615b;
    font-size: 10px;
}

.metric-value-light {
    margin-top: 1px;
    color: #000000;
    font-size: 18px;
    -unity-font-style: bold;
}

.control-panel {
    height: 216px;
}

.control-row {
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.control-label {
    width: 126px;
    font-size: 11px;
}

.control-button {
    flex-grow: 1;
    margin-right: 5px;
    height: 25px;
    min-width: 88px;
}

.knob-row {
    height: 24px;
    flex-direction: row;
    align-items: center;
}

.knob-label {
    width: 118px;
    font-size: 10px;
}

.knob-control {
    width: 23px;
    height: 23px;
    margin-right: 8px;
    flex-shrink: 0;
}

.knob-hint {
    flex-grow: 1;
    color: #66615b;
    font-size: 8px;
}

.time-speed-row {
    margin-top: 3px;
}

.time-speed-button {
    width: 48px;
    min-width: 44px;
    height: 23px;
    margin-right: 4px;
    font-size: 10px;
}

.music-row {
    margin-top: 2px;
}

.music-status-label {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 6px;
    font-size: 9px;
    white-space: normal;
}

.ai-panel {
    height: 320px;
}

.ai-assistant-row {
    flex-direction: row;
    min-height: 62px;
    margin-bottom: 4px;
    align-items: center;
}

.ai-assistant-portrait {
    width: 56px;
    height: 56px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    margin-right: 10px;
}

.ai-assistant-row .generated-widget-image {
    width: 74px;
    height: 47px;
    flex-shrink: 0;
}

.ai-assistant-caption {
    flex-grow: 1;
    font-size: 10px;
    white-space: normal;
}

.ai-panel .status-box {
    min-height: 36px;
    margin-top: 5px;
    padding: 4px;
    font-size: 10px;
}

.profile-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
}

.profile-status {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 430px;
    min-height: 86px;
    background-color: rgba(233, 230, 222, 0.92);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 12px;
}

.profile-status-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.profile-status-body {
    margin-top: 8px;
    font-size: 11px;
    white-space: normal;
}

.tutorial-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    bottom: 0;
    background-color: rgba(17, 17, 17, 0.28);
    align-items: center;
    justify-content: center;
}

.tutorial-panel {
    width: 640px;
    min-height: 300px;
    background-color: #e9e6de;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #111111;
    padding: 24px;
}

.tutorial-title {
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.tutorial-body {
    min-height: 140px;
    font-size: 14px;
    white-space: normal;
}

.tutorial-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

.tutorial-buttons .flat-button {
    width: 150px;
}
